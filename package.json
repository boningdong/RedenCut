{
  "name": "redencut",
  "version": "0.1.0-beta",
  "description": "Local-first podcast and audio editor",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "test:harness:faults": "vitest run --config vitest.harness.config.ts --mode faults",
    "test:harness:all": "vitest run --config vitest.harness.config.ts --mode all",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "speech:docker:build": "sh harness/container/run-speech.sh build",
    "speech:docker:provision": "sh harness/container/run-speech.sh provision",
    "speech:docker:preflight": "sh harness/container/run-speech.sh preflight",
    "clear:onboarding": "node scripts/clear-app-data.mjs onboarding",
    "clear:models": "node scripts/clear-app-data.mjs models",
    "setup:speech": "npm run runtime:setup",
    "speech:native:setup": "npm run setup:speech",
    "setup:speech-models": "sh speech-worker/run-native.sh provision",
    "speech:native:provision": "npm run setup:speech-models",
    "speech:native:preflight": "sh speech-worker/run-native.sh preflight",
    "harness:mcp": "node --import tsx harness/server.ts",
    "profile:waveform": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.performance.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"harness/**/*.{ts,cjs,json}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"harness/**/*.{ts,cjs,json}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" .prettierrc.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"harness/**/*.ts\" \"e2e/**/*.ts\" \"*.config.ts\"",
    "deadcode": "knip",
    "check": "npm run format:check && npm run lint && npm run deadcode && npm run typecheck && npm test && npm run build",
    "runtime:build": "node scripts/runtime/BuildRuntime.mjs",
    "runtime:setup": "node scripts/runtime/SetupRuntime.mjs",
    "runtime:check": "node scripts/runtime/CheckRuntime.mjs",
    "test:runtime": "node --test scripts/runtime/*.test.mjs",
    "runtime:stage": "node scripts/StageReleaseResources.mjs",
    "package:mac": "node scripts/PackageMac.mjs",
    "release:prepare": "node scripts/release/PrepareRelease.mjs",
    "release:draft": "node scripts/release/DraftRelease.mjs",
    "test:release": "node --test scripts/release/*.test.mjs"
  },
  "keywords": [],
  "author": "RedenCut contributors",
  "license": "Apache-2.0",
  "type": "commonjs",
  "volta": {
    "node": "24.14.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.80",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "40.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "^29.1.1",
    "knip": "6.32.1",
    "playwright": "1.63.0-alpha-2026-08-31",
    "prettier": "3.9.6",
    "tailwindcss": "^4.2.1",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "4.3.6",
    "zustand": "^5.0.11"
  }
}
