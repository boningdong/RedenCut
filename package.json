{
  "name": "audio-editor",
  "version": "1.0.0",
  "description": "",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "test:harness:faults": "vitest run --config vitest.harness.config.ts --mode faults",
    "test:harness:all": "vitest run --config vitest.harness.config.ts --mode all",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "harness:mcp": "node --import tsx harness/server.ts",
    "profile:waveform": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.performance.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"harness/**/*.{ts,cjs,json}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"harness/**/*.{ts,cjs,json}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" .prettierrc.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"harness/**/*.ts\" \"e2e/**/*.ts\" \"*.config.ts\"",
    "deadcode": "knip",
    "check": "npm run format:check && npm run lint && npm run deadcode && npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "volta": {
    "node": "24.14.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.80",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "40.8.0",
    "electron-vite": "^5.0.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "^29.1.1",
    "knip": "6.32.1",
    "playwright": "1.63.0-alpha-2026-08-31",
    "prettier": "3.9.6",
    "tailwindcss": "^4.2.1",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "4.3.6",
    "zustand": "^5.0.11"
  }
}
