{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // electron-vite and Vitest discover the real application, config, and test entries.
  "project": ["src/**/*.{ts,tsx,css}", "harness/**/*.{ts,cjs}", "e2e/**/*.ts", "*.config.ts"],
  // Docker installs Debian FFmpeg: ffprobe checks metadata; ffmpeg captures and analyzes real output.
  "ignoreBinaries": ["ffprobe", "ffmpeg"],
  // The dedicated runner selects this config with npm's dynamic --config argument.
  "entry": [
    "vitest.performance.config.ts",
    "src/renderer/src/components/Waveform/waveform.performance.ts",
    // The headed integration runner and Electron launcher select these entries dynamically.
    "harness/tests/**/*.integration.ts",
    "harness/tests/fixtures/*.cjs",
  ],
  "ignoreDependencies": [
    // Apple Silicon fallbacks loaded by resolveFromStaticPackage(packageName)
    // through runtime require(packageName) in src/main/audio/binaries.ts.
    "ffmpeg-static",
    "ffprobe-static",
  ],
  // Shared schemas and branded types are the deliberate domain/API surface even when a
  // particular member is only consumed by validation or external project files today.
  "ignoreIssues": {
    "src/shared/project.types.ts": ["exports", "types"],
    "src/shared/speech.types.ts": ["exports", "types"],
    "src/shared/speechWorker.types.ts": ["exports", "types"],
    "src/shared/transcriber.types.ts": ["types"],
  },
}
