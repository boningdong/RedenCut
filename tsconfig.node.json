{
  // TypeScript config for the Node.js side: main process + preload scripts.
  // NodeNext models modern Node package exports; package.json keeps .ts files
  // in CommonJS mode, while electron-vite still owns emitted bundles.
  "compilerOptions": {
    "composite": true,            // required for project references
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,      // allows `import x from 'cjs-module'`
    "skipLibCheck": true,
    "types": ["electron-vite/node"],
    "outDir": "dist-electron",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"]
    }
  },
  "include": [
    "*.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ]
}
