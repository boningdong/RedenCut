ARG REDENCUT_HARNESS_BASE=redencut-harness:local
FROM ${REDENCUT_HARNESS_BASE}

USER root
ENV REDENCUT_SPEECH_WORKER_ROOT=/opt/redencut-speech-worker
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip libsndfile1 build-essential cmake pkg-config curl patchelf \
    && rm -rf /var/lib/apt/lists/*

# Linux CPU regression image only: full macOS release certification is separate.
COPY --chown=node:node runtime/runtime-lock.json ./runtime/runtime-lock.json
COPY --chown=node:node scripts/runtime/NltkData.mjs ./scripts/runtime/NltkData.mjs
COPY --chown=node:node harness/container/build/speech/BuildSpeechRuntime.mjs harness/container/build/speech/BuildWhisperRuntime.sh ./harness/container/build/speech/
RUN node harness/container/build/speech/BuildSpeechRuntime.mjs native-tools
COPY speech-worker/pyproject.toml speech-worker/uv.lock ${REDENCUT_SPEECH_WORKER_ROOT}/
RUN --mount=type=cache,target=/root/.cache/uv \
    node harness/container/build/speech/BuildSpeechRuntime.mjs dependencies

COPY speech-worker/src ${REDENCUT_SPEECH_WORKER_ROOT}/src
COPY speech-worker/models.json ${REDENCUT_SPEECH_WORKER_ROOT}/models.json
COPY harness/container/config/VerifySpeechSource.sh /opt/redencut-verify-speech-source.sh
RUN --mount=type=cache,target=/root/.cache/uv \
    node harness/container/build/speech/BuildSpeechRuntime.mjs complete \
    && mkdir -p /models \
    && chown -R node:node ${REDENCUT_SPEECH_WORKER_ROOT} /models
COPY --chown=node:node harness/container/build/speech/WriteSpeechManifest.mjs ./harness/container/build/speech/WriteSpeechManifest.mjs
RUN node harness/container/build/speech/WriteSpeechManifest.mjs

ENV PATH="${REDENCUT_RUNTIME_ROOT}/speech-env/bin:${REDENCUT_RUNTIME_ROOT}/bin:${PATH}"
ENV PYTHONPATH="${REDENCUT_SPEECH_WORKER_ROOT}/src"
ENV PYTHONNOUSERSITE=1
ENV NLTK_DATA=${REDENCUT_RUNTIME_ROOT}/nltk_data
ENV REDENCUT_SPEECH_MANIFEST=${REDENCUT_SPEECH_WORKER_ROOT}/models.json
ENV REDENCUT_MODELS_PATH=/models

USER node
