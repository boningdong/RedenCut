ARG RIFFCUT_HARNESS_BASE=riffcut-harness:local
FROM ${RIFFCUT_HARNESS_BASE}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv libsndfile1 build-essential cmake git \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir --break-system-packages uv==0.12.12

ARG WHISPER_CPP_REVISION=a8d002cfd879315632a579e73f0148d06959de36
RUN git clone --filter=blob:none https://github.com/ggerganov/whisper.cpp.git /tmp/whisper.cpp \
    && git -C /tmp/whisper.cpp checkout "$WHISPER_CPP_REVISION" \
    && cmake -S /tmp/whisper.cpp -B /tmp/whisper.cpp/build -DBUILD_SHARED_LIBS=OFF -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=ON -DGGML_NATIVE=OFF -DGGML_CPU_ARM_ARCH=armv8-a \
    && cmake --build /tmp/whisper.cpp/build --target whisper-cli -j2 \
    && install /tmp/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli \
    && rm -rf /tmp/whisper.cpp

COPY speech-worker/pyproject.toml speech-worker/uv.lock /opt/riffcut-speech-worker/
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /opt/riffcut-speech-worker \
    && uv sync --frozen --no-dev --no-install-project
COPY speech-worker/src /opt/riffcut-speech-worker/src
COPY speech-worker/models.json /opt/riffcut-speech-worker/models.json
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /opt/riffcut-speech-worker \
    && uv sync --frozen --no-dev \
    && mkdir -p /models \
    && chown -R node:node /opt/riffcut-speech-worker /models

ENV PATH="/opt/riffcut-speech-worker/.venv/bin:${PATH}"
ENV PYTHONPATH="/opt/riffcut-speech-worker/src"
ENV RIFFCUT_SPEECH_MANIFEST="/opt/riffcut-speech-worker/models.json"
ENV RIFFCUT_SPEECH_MODEL_CACHE="/models"
ENV HF_HOME="/models/.huggingface"
ENV HF_HUB_CACHE="/models/.huggingface/hub"

USER node
